{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ELviewer",
  "version": "0.2.3",
  "identifier": "com.elviewer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ELviewer",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "dragDropEnabled": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#171c29"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Korean",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh",
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../models/supertonic-3/onnx/*": "models/supertonic-3/onnx/",
      "../models/supertonic-3/voice_styles/*": "models/supertonic-3/voice_styles/",
      "../models/supertonic-3/LICENSE": "models/supertonic-3/LICENSE"
    }
  }
}